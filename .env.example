# Copie para .env e ajuste. O .env nunca vai para o git.

DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Domínio do React do forms-meta (vírgula separa vários).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres local do docker-compose (porta 5436 no host). Em produção:
# database `dashboard_financeiro` na instância forms-meta-db, com role
# próprio (wiki: Banco de Dados). SSL liga sozinho para hosts *.render.com.
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/dashboard_financeiro

# Chave PÚBLICA RS256 do forms-meta, em PEM (wiki: Validação do JWT).
# Obrigatória — o processo não sobe sem ela. Pode ser multilinha ou numa
# linha só com \n. A chave PRIVADA nunca vem para este serviço.
# Para gerar um par local de desenvolvimento:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out _jwt_privada.pem
#   openssl pkey -in _jwt_privada.pem -pubout -out _jwt_publica.pem
# (o prefixo _ mantém os arquivos fora do git)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Cada empresa tem a própria conta Omie (multiempresa, D-32). As
# credenciais ficam no banco, CIFRADAS com esta chave Fernet — elas nunca
# vão para variável de ambiente. Gerar uma chave:
#   venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotação: várias chaves separadas por vírgula, a primeira cifra (ver
# apps/omie/cifra.py). Cadastrar credenciais de uma empresa:
#   venv/bin/python manage.py configurar_conta_omie --empresa-id <id>
OMIE_CREDENCIAIS_CHAVE=

LOG_LEVEL=INFO
